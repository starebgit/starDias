procedure TFcasiSt.Button3Click(Sender: TObject);
  var t1,t2,t3,dd : integer ;
begin
  Table1.First ;
  Odpri ;
  while not table1.eof do
  begin
    IsciTemp(table1koda.value,dd,t1,t2,t3) ;
    If dd > 0 then
    begin
      table1.edit ;
      Table1tk1.value := t1 ;
      Table1tk2.value := t2 ;
      Table1tk3.value := t3 ;
      Table1.post
    end ;
    Table1.next ;
  end ;
  Adoquery1.Close ;
end;


procedure TFcasiSt.isciTemp(kd: string; var dd,t1,t2,t3 : integer) ;
 var s1 : integer ;
     sif : string ;
     cc : boolean ;
begin
  dd := 0 ;
  if copy(kd,1,3) = '045' then
  begin
    sif := copy(kd,6,3) + copy(kd,10,3) ;
    cc := AdoQuery1.Locate('sifra_d',sif,[]) ;
  end else
    cc := AdoQuery1.Locate('koda_d',kd,[]) ;
  if cc then
  begin
    dd := 1 ;
    t1 := AdoQuery1.FieldbyName('tk1').value ;
    t2 := AdoQuery1.FieldbyName('tk2').value ;
    t3 := AdoQuery1.FieldbyName('tk3').value ;
  end ;
end ;

Procedure TFcasiSt.OdpriKd(kd : string) ;
begin
  Adoquery1.SQL.Clear ;
  Adoquery1.SQL.Add('SELECT * FROM DIA_00 where koda_d = :KOD')  ;
  Adoquery1.Parameters[0].Name := 'KOD' ;
  Adoquery1.Parameters[0].Value := kd ;
  Adoquery1.Open ;
end;

Procedure TFcasiSt.Odprisf(kd : string) ;
begin
  Adoquery1.SQL.Clear ;
  Adoquery1.SQL.Add('SELECT * FROM DIA_00 where sifra_d = :KOD')  ;
  Adoquery1.Parameters[0].Name := 'KOD' ;
  Adoquery1.Parameters[0].Value := kd ;
  Adoquery1.Open ;
end;

Procedure TFcasiSt.Odpri ;
begin
  Adoquery1.SQL.Clear ;
  Adoquery1.SQL.Add('SELECT * FROM DIA_00')  ;
  Adoquery1.Open ;
end;

procedure TFcasiSt.Button4Click(Sender: TObject);
  var dd,t1,t2,t3,tt,ii : integer ;
      kd,sf,kk,pk,dod,kdd : string ;
      kkon : sest ;
      prvi : boolean ;
begin
  Table1.First ;
  While not Table1.eof do
  begin

    kd := table1koda.value ;
    kd := copy(kd,1,12) ;
    for ii := 1 to 6 do kkon[ii] := false ;

    Isci(kd,dd,t1,t2,t3,tt,pk,kkon) ;
    if dd <> 0 then
    begin
      prvi := true ;
      for ii := 1 to 6 do if kkon[ii] then prvi := false ;
      if prvi then kkon[1] := true ;
      prvi := true ;
      for ii := 1 to 6 do
      begin
        case ii of
          1 : dod := '-00' ;
          2 : dod := '-01' ;
          3 : dod := '-11' ;
          4 : dod := '-21' ;
          5 : dod := '-10' ;
          6 : dod := '-20' ;
        end;
        if kkon[ii] then
        begin
          kdd := kd + dod ;
          if prvi then Table1.edit else Table1.Append ;
          Table1koda.value := kdd ;
          Table1dni.value := dd ;
          Table1tk1.value := t1 ;
          Table1tk2.value := t2 ;
          Table1tk3.value := t3 ;
          prvi := false ;
          Table1.Post ;
        end;
      end;
    end ;
    Table1.Next ;
  end ;
end;

