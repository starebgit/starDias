procedure TFcasiSt.Button6Click(Sender: TObject);
  var kd,kdd : string ;
      dd,t1,t2,t3,ts : integer ;
      bk : TBookmark ;
      pak : string ;
begin
  table1.first ;
  while not table1.eof do
  begin
     kd := Table1koda.value ;
     kdd := copy(kd,1,8) ;
    // if (kdd = '0056.810') or(kdd = '0055.832') or (kdd = '0055.933')  then
     if (kdd = '0055.813') or (kdd = '0055.913')  then
     begin
       // kd[15] := '2' ;
        kd[14] := '1' ;
        kd[15] := '0' ;
        dd := Table1dni.value ;
        t1 := Table1tk1.value ;
        t2 :=  Table1tk2.value ;
        t3 :=  Table1tk3.value  ;
        ts :=  Table1tstat.value  ;
        pak :=  Table1pakir.asstring  ;
        bk := table1.getBookmark ;
        if not Table1.Locate('koda',kd,[]) then
        begin
          Table1.Append ;
          Table1koda.value := kd ;
          Table1dni.value := dd ;
          Table1tk1.value := t1 ;
          Table1tk2.value := t2 ;
          Table1tk3.value := t3 ;
          Table1tstat.value := ts ;
          Table1pakir.asstring := pak ;
          Table1.Post ;
        end;
        Table1.GotoBookmark(bk);
     end;
     Table1.Next ;
  end;


end;

