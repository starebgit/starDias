     t1 := Adoquery1.Fieldbyname('tstar').value ;
     try
       ss := Adoquery1.Fieldbyname('pakiranje_nn').value ;
     except
       ss := ''
     end ;
 //    if ss = '' then ss := Table2.Fieldbyname('pakiranje_nn_1').value ;
     if ss = 'NAVITI' then cr := 'N' else cr := 'R' ;
     Table1.edit ;
     Table1tstat.value := t1 ;
     table1pakir.value := cr ;
     Table1.Post ;
  end ;
begin
  table1.First ;
   Adoquery1.SQL.Clear ;
  Adoquery1.SQL.Add('SELECT * FROM DIA_00')  ;
  Adoquery1.Open ;
 // table2.Open ;
  while not table1.eof do
  begin
    kd := table1Koda.value ;
    if copy(kd,1,2) <> '00' then
    begin
      sif := copy(kd,6,3) + copy(kd,10,3) ;
