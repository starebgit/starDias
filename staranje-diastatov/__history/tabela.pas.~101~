// poskušam pridobiti podatke o peèi
procedure TFtabela.Vpispei1Click(Sender: TObject);
  var pp : Integer ;
      kd,dd : string ;
      dat : TdateTime ;
begin
  dat := date - 30;
  dd := datetostr(dat) ;
  while not Table1.eof do
  begin
    if Round(Table1pec.AsFloat) = 0 then
    begin
      kd := copy(Table1koda.value,1,12) ;
      pp := Fvseb.getpec(kd,Table1datum.value+1) ;
      if pp > 0 then
      begin
        table1.edit ;
        Table1pec.AsFloat := pp;
        Table1.post ;
      end else
      begin
        pp := Fvseb.getpec(kd,Table1datum.value) ;
        if pp > 0 then
        begin
          table1.edit ;
          Table1pec.AsFloat := pp;
         Table1.post ;
        end
      end ;  
    end ;
    table1.Next ;
  end ;
