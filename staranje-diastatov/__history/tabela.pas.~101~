// donos in izmet za doloèeno potrditev
procedure TFtabela.getDonos(connection : variant; stnal,conf : string;  var yield,scrap : longint) ;
  var funct2,tabs : variant ;
      fdate : TdateTime ;
      mm,m : integer ;
      yie,scr : longint ;
begin
   fdate := date - 20  ;
   SAPFunctions1.Connection := Idispatch(Connection);
   funct2 := sapFunctions1.add('ZETA_RFC_READ_AFRU');
   Funct2.EXPORTS('dday').VALUE := fdate ;
   Funct2.EXPORTS('stnal').VALUE := stnal;
   funct2.call ;           // èe ni bilo v redu
   tabs := funct2.TABLES.item('IT_AFRU');    // tabela rezultatov
   mm := tabs.rowcount ;
   yield := 0 ;
   scrap := 0 ;
   for m := 1 to mm do
   begin
     if conf = Tabs.value(m,2) then
     begin
       yie :=  Tabs.value(m,38);
       scr :=  Tabs.value(m,40);
       if Tabs.value(m,95) = 'X' then yie := -yie ;
       yield := yield + yie;
       scrap := scrap + scr;
     end;
   end;
end ;

procedure TFtabela.PisiLog(logtxt : string) ;
  var ff : textfile ;
      imef : string ;
begin
  imef := ExtractFilePath(application.ExeName) + '\log.txt'  ;
  AssignFile(ff, imef);
  Append(ff);
  Writeln(ff, dateTimeTostr(now) + '  '  + logtxt) ;
  Flush(ff);
  CloseFile(ff);
end;

