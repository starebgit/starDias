unit stanje;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls;

type
  TFstanje = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    Memo1: TMemo;
    Memo2: TMemo;
    Memo3: TMemo;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
  private
    { Private declarations }
  public
    Procedure Vpis(str1,str2,str3: TstringList) ;
  end;

var
  Fstanje: TFstanje;

implementation

{$R *.dfm}


Procedure TFstanje.Vpis(str1,str2,str3: TstringList) ;
  var i : integer ;
begin
  Memo1.Clear ;
  Memo2.Clear ;
  Memo3.Clear ;
  panel2.Color := $02FF0000 ;
  for i := 0 to str1.Count-1 do
    memo1.Lines.Add(str1[i]) ;
  for i := 0 to str2.Count-1 do
    memo2.Lines.Add(str2[i]) ;
  for i := 0 to str3.Count-1 do
    memo3.Lines.Add(str3[i]) ;
  ShowModal ;
end;

end.
