unit peci;

interface

uses
  SysUtils, Windows, Messages, Classes, Graphics, Controls,
  StdCtrls, Forms, DBCtrls, DB, DBGrids, DBTables, Grids, ExtCtrls;

type
  TFpeci = class(TForm)
    Table1STEV: TSmallintField;
    Table1OZNAKA: TStringField;
    Table1TEMP: TSmallintField;
    DBGrid1: TDBGrid;
    Panel1: TPanel;
    DataSource1: TDataSource;
    Panel2: TPanel;
    Table1: TTable;
    Table1IDENT: TStringField;
    Button1: TButton;
    Table1KAPAC: TFloatField;
    Table1TRENUT: TFloatField;
    Table1STDNI: TSmallintField;
    procedure FormCreate(Sender: TObject);
    procedure Button1Click(Sender: TObject);
  private
    Procedure Odpri ;
  public
    procedure Pregled ;
    Procedure Getlist(listpec : TstringList) ;
    Procedure Getpec(cs,tt : integer; pk : string; var listpec : TstringList)  ;
    function Getrav(nn : Integer) : string ;
    function Getkap(nn : Integer) : longint ;
  end;

var
  Fpeci: TFpeci;

implementation

{$R *.DFM}

Procedure Tfpeci.Odpri ;
  var dir : string ;
begin
  dir := ExtractFilePath(application.ExeName) ;
  table1.databasename := dir ;
  Table1.open ;
end;

procedure TFpeci.FormCreate(Sender: TObject);
begin
 // Table1.Open;
end;

procedure Tfpeci.Pregled ;
begin
  Odpri ;
  ShowModal ;
  Table1.close ;
end ;

// procedura izdela listo vseh peèi z osnovnimi podatki o peèi
Procedure TFPeci.Getlist(listpec : TstringList) ;
  var ss : string ;
begin
   Odpri ; ;
  While Not table1.eof do
  begin
    ss := Format('%2d',[table1stev.value])  + Table1oznaka.value ;
    ss := ss + '_' +  Format('%3d',[table1temp.value]) + '_' +  Format('%1d',[table1stdni.value])  ;
    Listpec.add(ss) ;
    Table1.Next
  end ;
  Table1.Close ;
end ;

// procedura izdela listo peèi s predpisanimi lastnostmi
Procedure TFPeci.Getpec(cs,tt : integer; pk : string; var listpec : TstringList)  ;
  var ss : string ;
begin
   Odpri  ;
  if pk = 'N' then pk := 'K' ;
  if tt = 200 then tt := 150 ;
  if tt = 100 then tt := 80 ;
  While Not table1.eof do
  begin
    if (table1stdni.value = cs) and (table1temp.value = tt) and (table1oznaka.value = pk) then
    begin
      ss := Format('%2d',[table1stev.value])  + Table1oznaka.value ;
      ss := ss + '_' +  Format('%3d',[table1temp.value]) + '_' + Format('%1d',[table1stdni.value]) ;
      ss := ss + '     ' + Format('%-5d',[round(table1trenut.value)]);
      Listpec.add(ss) ;
    end ;  
    Table1.Next
  end ;
  Table1.Close ;
end ;

// funkcija vrne podatek ravni/naviti za doloèeno peè
function TFPeci.Getrav(nn : Integer) : string ;
  var ss : string ;
begin
   Odpri ;
  Table1.First ;
  While not table1.eof do
  begin
    if table1stev.value = nn then ss := Table1oznaka.value ;
    table1.next ;
  end ;
  result := ss ;
  Table1.Close ;
end ;

function TFPeci.Getkap(nn : Integer) : longint ;
  var ix : longint ;
begin
   Odpri ;
  Table1.First ;
  While not table1.eof do
  begin
    if table1stev.value = nn then ix := round(Table1kapac.value) ;
    table1.next ;
  end ;
  result := ix ;
  Table1.Close ;
end ;


procedure TFpeci.Button1Click(Sender: TObject);
begin
  Table1.first ;
end;

end.