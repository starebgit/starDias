unit stanje;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls, printers;

type
  TFstanje = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    Memo1: TMemo;
    Memo2: TMemo;
    Memo3: TMemo;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    Label4: TLabel;
    Button1: TButton;
    Button2: TButton;
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    Procedure Vpis(dd: TdateTime; pc : integer;str1,str2,str3: TstringList) ;
  end;

var
  Fstanje: TFstanje;

implementation

{$R *.dfm}


procedure TFstanje.Button1Click(Sender: TObject);
  var   MojaDat : TextFile ;
        i : integer ;
begin
   AssignPrn(MojaDat) ;
   Rewrite(MojaDat) ;
   writeln(Mojadat,label4.Caption) ;
   Writeln(Mojadat) ;
   Writeln(Mojadat,'V peèi') ;
   for i := 0 to Memo1.Lines.Count-1 do
      Writeln(Mojadat,'  ' + Memo1.Lines[i]) ;
    Writeln(Mojadat) ;
   Writeln(Mojadat,'Na izhodu') ;
   for i := 0 to Memo2.Lines.Count-1 do
      Writeln(Mojadat,'  ' + Memo2.Lines[i]) ;
end;

Procedure TFstanje.Vpis(dd: TdateTime; pc : integer; str1,str2,str3: TstringList) ;
  var i : integer ;
begin
  height := 800 ;
  Memo1.Clear ;
  Memo2.Clear ;
  Memo3.Clear ;
  memo1.Height := 650 ;
  memo2.Height := 650 ;
  label4.Caption := 'Stanje na dan ' + dateToStr(dd) + '  za peè ' + IntTostr(pc) ;
  panel2.Color := $02FFC0FF ;
  for i := 0 to str1.Count-1 do
    memo1.Lines.Add(str1[i]) ;
  for i := 0 to str2.Count-1 do
    memo2.Lines.Add(str2[i]) ;
  for i := 0 to str3.Count-1 do
    memo3.Lines.Add(str3[i]) ;
  ShowModal ;
end;

end.
