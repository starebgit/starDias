procedure TFquery.KopirajNalogeClick(Sender: TObject);
var
  ClipboardText: string;
begin
  ClipboardText := '';  // Initialize

  ADOQuery1.First;  // Move to the first record
  while not ADOQuery1.Eof do
  begin
    ClipboardText := ClipboardText + ADOQuery1.FieldByName('NALOG').AsString + sLineBreak;
    ADOQuery1.Next;
  end;

  Clipboard.AsText := ClipboardText;  // Copy to clipboard
  ShowMessage('Stolpec Nalogov je bil kopiran v odložišèe. Prilepite ga s Ctrl + V.');
end;

