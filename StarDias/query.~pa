{$R *.DFM}

procedure TFquery.FormCreate(Sender: TObject);
begin
  //Query1.Open;
end;

// procedura za prikaz vsebine tabele za en dan
procedure TFquery.pokazi(dat : Tdatetime;ix : integer);
begin
  dst := dat ;
  caption := 'Iz peèi na dan ' + datetostr(dat) ;
  Query1.SQL.Clear ;
  case ix of
    2 : Query1.SQL.Add('Select * From stara Where (datum + doba = :nod) and (tip = ''X'' or tip = ''U'' ) order by tip, koda') ;
    1 : Query1.SQL.Add('Select * From stara Where (datum + doba = :nod) and (tip = ''Y'') order by tip, koda') ;
    3 : Query1.SQL.Add('Select * From stara Where datum + doba = :nod  order by  koda') ;
  end ;
  Query1.params[0].Asdate := dat ;
  Query1.Open ;

  Query1.last ;
  ShowModal ;
  Query1.Close ;

end ;

// izpis prikazane tabele na papir
procedure TFquery.Button1Click(Sender: TObject);
  var   MojaDat : TextFile ;
        capp,cap1,cap2,uu : string ;
        cc,ix,c1,i,kk : integer;
begin
   AssignPrn(MojaDat) ;
   Rewrite(MojaDat) ;

   capp := 'K O N T R O L N I     L I S T / ' + dateToStr(dst);
   cap1 :=  'E T A   Cerkno' ;
   cap2 := 'Datum : ' + DateToStr(date) + '  ' + TimeTostr(Time) ;
   Printer.Canvas.Font.Name := 'Courier New' ;
   Printer.Canvas.Font.Size := 12 ;
   cc := printer.PageWidth div Printer.Canvas.TextWidth('P') ;
   c1 := cc - length(cap1) - length(cap2) ;
   Writeln (MojaDat,cap1 + StringofChar(' ',c1)+Cap2) ;
   Writeln (MojaDat,'DE Termoregulator') ;

   Printer.Canvas.Font.Size := 16 ;
   cc := printer.PageWidth div Printer.Canvas.TextWidth('P') ;
   ix := (cc - length(Capp)) div 2 ;
   Writeln(MojaDat,StringofChar(' ',ix)+Capp) ;

   Printer.Canvas.Font.Size := 12 ;
   Writeln(MojaDat,'') ;
   Writeln(MojaDat,'') ;

   Writeln(MojaDat,Format('%10s%18s%8s%4s%13s%12s%12s',['Nalog','Material',
                            'Donos','Peè','Del. mesto', 'Datum','TK1/TK2/TK3'])) ;

   Writeln(MojaDat,'') ;

   // izpis posameznih vrstic
   query1.First ;
   uu := query1tip.value ;
   kk := 1 ;
   while not query1.eof do
   begin
     if uu <> query1tip.value then
     begin
        Writeln(MojaDat)  ;
        Writeln(MojaDat) ;
        kk := kk+2 ;
        uu := query1tip.value
     end ;
     if kk = 56 then Writeln(MojaDat) ;
     Writeln(MojaDat,Format('%10s%18s%8s%4s%13s%12s%12s',[query1nalog.value,query1koda.value,
                       IntTostr(round(query1donos.value)),IntTostr(query1pec.value),query1delmesto.value,DateTostr(query1datum.value),
                       IntTostr(round(query1tk1.value))+'/'+IntTostr(round(query1tk2.value))+'/'+IntTostr(round(query1tk3.value))])) ;
     inc(kk) ;
     query1.Next ;
   end ;
   System.CloseFile(MojaDat) ;
end;

