procedure TFvseb.Button5Click(Sender: TObject);
  var dd : TdateTime ;
      pc : integer ;
      dni,t1,t2,t3,ss,tt : integer ;
      pk : string ;
      str1,str2,str3 : TstringList ;
begin
  fdoloci.Izbor(dd,pc) ;
  if pc = 0 then exit ;

  str1 := TstringList.Create ;
  str2 := TstringList.Create ;
  str3 := TstringList.Create ;
//  Table1.SetRange([dd-5],[dd]) ;
  Table1.First ;
  while Not table1.eof do
  begin
    if table1pec.Value = pc then
    begin
      FcasiSt.najdi_00(Table1Koda.value,dni,t1,t2,t3,tt,pk)  ;
      if dni > 0 then
      begin
        if table1datum.Value + dni > dd then str1.Add(Table1koda.Value) ;
        if table1datum.Value + dni = dd then str2.Add(Table1koda.Value)
      end else str3.Add(Table1koda.Value)
    end;
    Table1.Next ;
  end;
  Fstanje.Vpis(dd,pc,str1,str2,str3) ;
  str1.Free ;
  str2.Free ;
  str3.Free ;
end;

Procedure TfVseb.Obnovi ;
  var cc : boolean ;
      dni,t1,t2,t3,ss,dd,tt : integer ;
      pk : string ;
      bb : boolean ;
begin
  cc := Table1.active ;
  If not cc then Table1.Open ;
  Table1.First ;
  while not table1.eof do
  begin
    bb := false ;
    if Table1status.value <> 2 then
    begin
      FcasiSt.najdi_00(Table1Koda.value,dni,t1,t2,t3,tt,pk)  ;
     // if dni = 0 then dni := 5 ;

      if dni > 0 then
      begin
        ss := 0 ;
        dd := trunc(date - Table1datum.value) ;
        if dd = dni then ss := 1 ;
        If dd > dni then ss := 2 ;
        if ss > 0 then
        begin
          table1.edit ;
          Table1status.value := ss ;
          Table1.Post ;
          if ss = 2 then bb := true ;
        end ;
      end ;
    end ;
    if not bb then Table1.Next
  end ;
  If not cc then Table1.Close ;
end ;



function TFvseb.getpec(kd : string; dd : TdateTime): Integer ;
begin
  Table1.Open ;
  if copy(kd,1,2) <> '00' then kd := FcasiSt.stark(kd) ;
  if Table1.Locate('koda;datum',VarArrayOf([kd,dd]),[]) then
    getpec := Table1pec.value
  else
    getpec := 0 ;
  Table1.Close ;
end ;  

