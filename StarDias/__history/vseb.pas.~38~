procedure TFvseb.Posodobi(var postav : vpeci);
  var arrpc : array[1..20] of longint ;
      stpec : longint ;
      i : integer ;
      fs : string ;
      dt : TdateTime ;
      kd : string ;
begin
  fs := Table1.filter ;
  dt := date-30 ;
  Table1.filter := 'status = 0 and datum > ' +  '''' + DateToStr(dt) + ''''  ;

  for i := 1 to 20 do arrpc[i] := 0 ;
  for i := 1 to 20 do postav[i] := 0 ;
  Table1.First ;
  While not table1.eof do
  begin
    kd := table1koda.Value ;
    stpec := table1pec.value ;
    if (stpec <1) or (stpec > 16) then Showmessage(dateTostr(table1datum.value))
    else begin
      arrpc[stpec] := arrpc[stpec] + Table1kolic.value ;
      postav[stpec] := postav[stpec] + 1 ;
    end;

    stpec := table1pec1.value ;
    if (stpec > 0) and (stpec < 17) then
    begin
      arrpc[stpec] := arrpc[stpec] + Table1kolic.value ;
      postav[stpec] := postav[stpec] + 1 ;
    end;
    Table1.next ;
  end ;
  with Fpeci do
  begin
    Odpri ;
    While Not table1.eof do
    begin
      Table1.edit ;
      stpec := table1stev.value ;
      Table1trenut.value := arrpc[stpec] ;
      Table1.Next
    end ;
    Table1.Close ;
    //pregled ;
  end ;
  Table1.filter := fs ;
end;


procedure TFvseb.Zasedenost1Click(Sender: TObject);
  var ipec : integer ;
      kd,pk,fl : string ;
      xx,kap : longint ;
      cs,t1,t2,t3,tt : Integer ;
      clist : Tlist ;
      nasel : boolean ;
      pp : ^danPec ;
      dt,dz : TdateTime ;
      i,j : Integer ;
begin
  clist := Tlist.create ;
  dz := StrTodate('15.08.2014') ;
  while dz <= date do
  begin
    new(pp) ;
    pp^.datum := dz ;
    pp^.klDia := 0;
    clist.add(pp) ;
    dz := dz + 1 ;
  end ;
  fl := table1.Filter ;
  table1.Filter := '' ;
  table1.First ;
  ipec := StrToInt(Inputbox('Štvilka peèi','','1')) ;
  kap := Fpeci.Getkap(ipec) ;
  while Not table1.eof do
  begin
    if table1pec.value = ipec then
    begin
      xx := Table1kolic.value ;
      kd := Table1Koda.value ;
      dt := Table1datum.value ;
      FcasiSt.najdi_00(kd,cs,t1,t2,t3,tt,pk) ;
      for j := 1 to cs do
      begin
        nasel := false ;
        for i := 0 to clist.count-1 do
        begin
          pp := clist[i] ;
          if dt = pp^.datum then pp^.klDia := pp^.klDia + xx ;
        end ;
        dt := dt + 1 ;
      end ;
    end ;
    Table1.Next
  end ;
  table1.Filter := fl ;
  FXkarta.Prikazi1(kap,clist) ;
  Clist.Free ;
end;

