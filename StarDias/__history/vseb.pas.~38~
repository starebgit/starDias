procedure TFvseb.Koliine1Click(Sender: TObject);
  var kol : longint ;
      dat1,dat2,dd : TdateTime ;
begin
  Table1.first ;
  Fdoba.Vpisi(dat1,dat2) ;
  kol := 0 ;
  While not table1.eof do
  begin
    dd := table1datum.value ;
    if (dd >= dat1) and (dd <= dat2) then kol := kol + table1kolic.value ;
    table1.next ;
  end ;
  Showmessage(IntTostr(kol)) ;
end;

procedure TFvseb.ZasedenostExcel1Click(Sender: TObject);
 var ipec : integer ;
      kd,pk,fl : string ;
      xx,kap : longint ;
      cs,t1,t2,t3,tt : Integer ;
      clist : Tlist ;
      nasel : boolean ;
      pp : ^danPec ;
      excel : variant ;
      dt,dz,dz1,dz2 : TdateTime ;
      i,j : Integer ;
begin
  clist := Tlist.create ;
  dz1 := StrTodate('01.07.2015') ;
  dz2 := StrTodate('31.07.2015') ;
  dz := dz1 ;
  while dz <= dz2 do
  begin
    new(pp) ;
    pp^.datum := dz ;
    pp^.klDia := 0;
    clist.add(pp) ;
    dz := dz + 1 ;
  end ;
  fl := table1.Filter ;
  table1.Filter := '' ;
  table1.First ;
  ipec := StrToInt(Inputbox('Štvilka peèi','','1')) ;
  kap := Fpeci.Getkap(ipec) ;
  while Not table1.eof do
  begin
    if (table1pec.value = ipec) and (table1datum.value >= dz1) and (table1datum.value <= dz2) then
    begin
      xx := Table1kolic.value ;
      kd := Table1Koda.value ;
      dt := Table1datum.value ;
      FcasiSt.najdi_00(kd,cs,t1,t2,t3,tt,pk) ;
      for j := 1 to cs do
      begin
        nasel := false ;
        for i := 0 to clist.count-1 do
        begin
          pp := clist[i] ;
          if dt = pp^.datum then pp^.klDia := pp^.klDia + xx ;
        end ;
        dt := dt + 1 ;
      end ;
    end ;
    Table1.Next
  end ;
  table1.Filter := fl ;

  excel := GetActiveOLEObject('Excel.application');
  for i := 0 to clist.count-1 do
  begin
    pp := clist[i] ;
    //excel.Cells[i+1,1] := pp^.datum ;
    excel.Cells[i+1,ipec+1] := pp^.Kldia ;
  end ;
  Clist.Free ;
end;

